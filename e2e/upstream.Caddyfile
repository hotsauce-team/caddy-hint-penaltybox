# Stub origin: echoes the requested hint level back as the response
# header — the same wire contract the CMS emits with
# rateLimitHints: 'header'.
{
	admin off
	auto_https off
}

:8081 {
	header X-Rate-Limit-Level "{query.level}"
	# Explicit freshness so Souin stores the response (RFC 7234).
	header Cache-Control "public, max-age=30"
	respond "upstream ok" 200
}
