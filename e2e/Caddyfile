# The module-enabled Caddy under e2e test. Budgets are tuned small so
# the scenario script boxes quickly and recovers within seconds.
{
	admin off
	auto_https off

	# Souin HTTP cache backed by Otter (in-memory) storage.
	cache {
		ttl 30s
		otter
	}

	servers {
		# The e2e runner lives on the compose network (private range), so
		# its X-Forwarded-For is trusted and {client_ip} resolves to it —
		# this exercises the real client-key path the design doc mandates.
		trusted_proxies static private_ranges
	}
}

# Plain penalty box, no caching.
:8080 {
	route {
		hint_penaltybox {
			min_level 2
			window 10s
			limit 6
			penalty_ttl 3s
		}
		reverse_proxy e2e-upstream:8081
	}
}

# Two-tier policy: tight tier-3 budget (think logins), loose tier-2
# budget (elevated admin traffic), enforced independently per client.
:8091 {
	route {
		hint_penaltybox {
			tier 3 {
				window      30s
				limit       2
				penalty_ttl 3s
			}
			tier 2 {
				window      30s
				limit       50
				penalty_ttl 1m
			}
		}
		reverse_proxy e2e-upstream:8081
	}
}

# Penalty box in front of the Souin cache: boxed clients are rejected
# before the cache, stored responses replay their hint header through
# the module (so cache hits count and stay stripped).
:8090 {
	route {
		hint_penaltybox {
			min_level 2
			window 10s
			limit 6
			penalty_ttl 3s
		}
		cache
		reverse_proxy e2e-upstream:8081
	}
}
